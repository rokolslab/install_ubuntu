# Пример правил firewall для UFW
# Использование: скопируйте только нужные правила и выполните через sudo ufw.

# ============================================
# БАЗОВАЯ БЕЗОПАСНАЯ ПОСЛЕДОВАТЕЛЬНОСТЬ
# ============================================

# 1. Разрешить SSH первым, иначе можно потерять доступ.
sudo ufw allow 22/tcp comment 'SSH'

# Если изменили SSH port, используйте фактический порт.
# sudo ufw allow 2222/tcp comment 'SSH Custom Port'

# 2. Закрыть входящие по умолчанию и разрешить исходящие.
sudo ufw default deny incoming
sudo ufw default allow outgoing

# 3. Включить firewall.
sudo ufw --force enable

# 4. Проверить статус.
sudo ufw status verbose

# ============================================
# WEB / AI-STACK: HTTP/HTTPS
# ============================================

# Открывайте 80/443 только для web/reverse proxy сценария.
sudo ufw allow 80/tcp comment 'HTTP'
sudo ufw allow 443/tcp comment 'HTTPS'

# ============================================
# PROXY / X-UI: ЯВНЫЕ SERVICE PORTS
# ============================================

# Не открывайте proxy panel/service ports автоматически.
# После установки панели разрешите только реально нужный порт.
# sudo ufw allow 54321/tcp comment 'Explicit proxy service port'
# sudo ufw allow 8443/tcp comment 'Explicit proxy panel port'

# ============================================
# ОГРАНИЧЕНИЯ ПО IP
# ============================================

# SSH только с определённого IP.
# sudo ufw allow from YOUR_IP_ADDRESS to any port 22 proto tcp comment 'SSH from trusted IP'

# Admin panel только с определённого IP.
# sudo ufw allow from YOUR_IP_ADDRESS to any port 8443 proto tcp comment 'Panel from trusted IP'

# ============================================
# ВНУТРЕННИЕ СЕРВИСЫ AI STACK
# ============================================

# PostgreSQL, Redis, Supabase Studio, n8n, Prometheus и Grafana не открывайте наружу напрямую.
# Используйте localhost binding, SSH tunnel или reverse proxy с auth/TLS.

# Redis только для внутренней сети, если это действительно нужно.
# sudo ufw allow from 10.0.0.0/8 to any port 6379 proto tcp comment 'Redis Internal'

# ============================================
# ДИАГНОСТИКА И УПРАВЛЕНИЕ
# ============================================

# Просмотр правил.
# sudo ufw status verbose

# Просмотр правил с номерами для удаления.
# sudo ufw status numbered

# Удаление правила по номеру.
# sudo ufw delete NUMBER

# Отключение firewall не рекомендуется.
# sudo ufw disable
